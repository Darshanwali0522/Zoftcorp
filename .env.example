# Zoftcorp Website - Environment Variables Template
# Copy this file to .env.local and populate with your production or local development credentials.

# Supabase Integration (CMS & Submissions Management)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Automated Dual Email Notifications (Gmail / Google Workspace SMTP via Nodemailer)
# Official admin notification recipient for ALL website submissions
ADMIN_NOTIFICATION_EMAIL=info@zoftcorp.com

# Verified sender address
EMAIL_FROM=Zoftcorp <info@zoftcorp.com>

# Google Workspace / Gmail SMTP Authentication Account
GMAIL_USER=info@zoftcorp.com
GMAIL_APP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD

# Optional legacy aliases (also supported automatically)
# SMTP_USER=info@zoftcorp.com
# SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
# ADMIN_EMAIL=info@zoftcorp.com
